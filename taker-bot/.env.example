# Taker Bot env - copy to .env and fill. NEVER commit .env.

# --- Identity ---------------------------------------------------------------
# Maker: position owner. ONLY this maker's strategies may be touched.
# The bot refuses any strategyHash outside BOT_STRATEGIES (when set).
BOT_MAKER=

# Taker: wallet that pays tokenIn and receives tokenOut. May equal maker
# (self-fill is allowed by the router). Defaults to BOT_MAKER.
BOT_TAKER=

# --- Keys (server-only) -----------------------------
# Taker private key. Used ONLY to sign approvals + swaps. Fund with small
# amounts (tick budget x a few ticks + gas). BOT_PK is accepted as alias.
BOT_PK=

# 1inch API key: READS strategy bytes/prices only. No funds touch it.
BOT_1INCH_KEY=

# --- Mode --------------------------------------------------------------------
# Dry-run default (anything but exactly "true" = simulate only, submit never).
# Set "true" ONLY when ready for real txs with real funds.
BOT_LIVE=false

# --- Schedule & budgets -------------------------------------------------------
# Tick interval ms (300000 = 5 min). First run 10s after boot.
BOT_INTERVAL_MS=300000
# Hard stop per UTC day. Ticks beyond this are refused (zero gas).
BOT_MAX_TICKS_PER_DAY=48
# Max declared USD per tick. Ticks above are refused before quoting.
BOT_TICK_BUDGET_USD=1
# HTTP port.
BOT_PORT=3101
# RPC endpoint (dedicated key recommended, public endpoints rate-limit).
BOT_RPC_URL=https://mainnet.base.org

# --- Routes: WHAT the bot may touch -------------------------------------------
# Comma-separated strategy hashes. Empty = allow all (logged as warning).
# This is the primary safety boundary alongside budgets.
BOT_STRATEGIES=0x...

# JSON array, run in order every interval. Fields per route:
#   strategy  - must be in BOT_STRATEGIES (else refused)
#   tokenIn   - token the taker pays (e.g. USDC to buy WETH out)
#   amountRaw - exact-in input WEI, "max" with exactOut (drain whole side),
#               or "half" (drain half the side, keeps position alive longer)
#   sizeUsd   - DECLARED usd, must be <= budget and SHOULD match amountRaw
#               (amountRaw is authoritative for the fill; sizeUsd gates econ)
#   exactOut  - optional true: fix OUTPUT instead (drain needs this with "max")
# Back-and-forth volume = two routes, opposite directions, same strategy.
BOT_ROUTES=[{"strategy":"0x...","tokenIn":"0x...","amountRaw":"1000000","sizeUsd":1}]

# --- Demo/econ tuning ----------------------------------------------------------
# Skip the gas-vs-fee gate (demo only: ticks that lose money still run).
BOT_SKIP_ECON=false
# Assumed taker-fee capture in bps for the econ gate (10 = 0.1%).
BOT_FEE_BPS=10
# Emit machine-readable JSON log lines alongside human lines.
BOT_JSON_LOGS=false
# Print full stack on tick crash (dev only, keep off in prod).
BOT_DEBUG_STACK=false
