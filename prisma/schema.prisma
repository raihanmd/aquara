generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Delegation {
  id             String   @id @default(cuid())
  delegator      String   @db.VarChar(42)
  delegate       String   @db.VarChar(42)
  chainId        Int      @default(8453)
  delegationJson Json
  // alias: delegation field in API maps to delegationJson
  signature      String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime?
  revoked        Boolean  @default(false)
  revokedAt      DateTime?

  @@index([delegator])
  @@index([delegate])
  @@index([chainId])
  @@index([expiresAt])
  @@map("delegations")
}
