
# Backend proxy target (Next.js rewrites /backend/* -> BACKEND_URL/*)
BACKEND_URL=http://localhost:3001

# 1inch Aqua API key (https://portal.1inch.dev)
NEXT_PUBLIC_1INCH_API_KEY=your_1inch_api_key_here

# Base RPC — DRPC or any Base mainnet endpoint
NEXT_PUBLIC_RPC_URL=https://lb.drpc.live/base/YOUR_DRPC_KEY

# Robinhood RPC
NEXT_PUBLIC_RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# Chain ID — 4663 Robinhood (0.25% vol, gas murah), 8453 Base, 1 Ethereum
NEXT_PUBLIC_CHAIN_ID=4663
