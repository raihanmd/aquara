DATABASE_URL="postgresql://aqua:aqua@localhost:5432/aqua?schema=public"

# 1inch API key, server-only (https://portal.1inch.dev)
# All Aqua reads go through /api/aqua/* so the key never reaches browsers.
ONEINCH_API_KEY=your_1inch_api_key_here

NEXT_PUBLIC_RPC_URL=https://lb.drpc.live/base/YOUR_DRPC_KEY

NEXT_PUBLIC_CHAIN_ID=8453

NEXT_PUBLIC_AGENT_ADDRESS=0x5235401AbA9b0f597A19B48497bf174a4dA8A090

RELAYER_PRIVATE_KEY=0x...

# Fee policy for agent submits (percent of estimated fees, 50-500).
# 100 = network rate (default, no overpay). Below 100 = slower/cheaper but
# risks stuck txs; retries always bump above the first attempt.
# RELAYER_GAS_MULT_BPS=100

# Service key for the internal rotator cron path on /api/agent/deploy (x-cron-key header). Server-only.
# Generate: openssl rand -hex 32. Must match ROT_CRON_KEY in rotator/.env.
CRON_API_KEY=

# Trash thresholds for rotation signals (unset = compiled defaults).
# TRASH_MIN_VOLUME_USD=1.0
# TRASH_MAX_APY_PCT=null
# TRASH_ZERO_VOLUME_BOTH=true
# TRASH_FORCE_HASHES=0xabc...,0xdef...
# TRASH_ALL=false
# TRASH_GRACE_HOURS=6
# TRASH_APY_VS_TOP=0.1
# TRASH_MIN_VOLUME_RATIO=0.05
# TRASH_MIN_FEE_RATIO=0.001
# TRASH_EFF_MIN_AGE_H=6