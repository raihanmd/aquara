# Web backend base URL (rotation reads makers/strategies/positions, triggers deploys)
ROT_WEB_BASE=http://localhost:3000

# Base RPC for onchain reads (balances, allowances, quotes)
ROT_RPC_URL=https://base-mainnet.g.alchemy.com/v2/6dNtbCCc1T-CMZLqxjc0Y50Rr5rwR6sB

# Aqua registry + app addresses on Base (defaults are current mainnet values)
ROT_AQUA=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
ROT_APP=0x111111338c5091e8440b67b168bae16a668ac0de

# Relayer key: submits dock calls through the Calibur agent key (server-only, never commit)
ROT_RELAYER_KEY=0x326615c08d8a158e38f5e4f2d0e3872cbe2c4c53d0fc07f416abb33a66417ccf

# Service key for the internal BE cron path on /api/agent/deploy (must match CRON_API_KEY in web/.env)
ROT_CRON_KEY=f3126eda8584c3c7209c3a672f6149a1c5d271bef4bf3f50233f74c4bd904ee2

# 1inch API key for Aqua reads proxied by web (server-only)
ROT_ONEINCH_KEY=OTXakxyJ2bDS7ACmje4jSikFRU6tR6L4

# AI advisor (same rubric as before: LOW/MEDIUM/HIGH rotation urgency)
ROT_AI_URL=https://ai.raihanmd.xyz/v1/chat/completions
ROT_AI_MODEL=n8n-1
ROT_AI_KEY=sk-f0583489824bbd65-w259r7-a4da0ffb
ROT_AI_MAX_TOKENS=2000
ROT_AI_ENABLED=true

# Gain gate: rotate only when estimated gain >= 2x gas (20000 bps)
ROT_MIN_GAIN_BPS=11000
ROT_GAS_USD=0.01

# Caps: max 1 rotation per maker per day, $1 gas per day
ROT_MAX_PER_DAY=100
ROT_DAILY_GAS_CAP_USD=1.0

# Scheduler + safety
ROT_INTERVAL_MS=900000
ROT_PORT=3102
ROT_LIVE=true
